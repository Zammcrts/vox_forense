# Copia este archivo como .env (en la raiz del proyecto). Se carga solo al iniciar.
DATABASE_URL=
VOX_API_URL=   # las @tool de la Crew llaman a la API por HTTP (httpx); vacio = en proceso
VOX_API_KEY=                          # si lo defines, la API exige la cabecera X-API-Key
VOX_MAX_MB=

# LLM local con Ollama (sin clave):  ollama pull llama3.1:8b
VOX_LLM=         # "simulado" = guion determinista para ensayar sin modelo
OLLAMA_BASE_URL=
VOX_CREW_TIMEOUT_S=              # tope de tiempo de la Crew; si se excede o un agente no llama su herramienta, el sistema completa esa etapa (queda SUPLENCIA en la traza)
